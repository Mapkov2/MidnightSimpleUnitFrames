package-as: MidnightSimpleUnitFrames
enable-nolib-creation: no

move-folders:
  MidnightSimpleUnitFrames/MidnightSimpleUnitFrames: MidnightSimpleUnitFrames
  MidnightSimpleUnitFrames/MidnightSimpleUnitFrames_Castbars: MidnightSimpleUnitFrames_Castbars

ignore:
  - .github
  - .idea
  - CHANGELOG.md
  - dist
  - tools
  - README.md
  - VERSION

manual-changelog: CHANGELOG.md
