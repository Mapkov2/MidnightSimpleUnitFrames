package-as: MidnightSimpleUnitFrames
enable-nolib-creation: no

move-folders:
  MidnightSimpleUnitFrames/MidnightSimpleUnitFrames: MidnightSimpleUnitFrames
  MidnightSimpleUnitFrames/MidnightSimpleUnitFrames_Assistant: MidnightSimpleUnitFrames_Assistant

ignore:
  - .github
  - .idea
  - CHANGELOG.md
  - dist
  - MidnightSimpleUnitFrames/.codex-remote-attachments
  - MidnightSimpleUnitFrames/**/.codex-remote-attachments
  - MidnightSimpleUnitFrames/docs
  - MidnightSimpleUnitFrames/scripts
  - MidnightSimpleUnitFrames/tools
  - MidnightSimpleUnitFrames/**/graphify-out
  - MidnightSimpleUnitFrames/**/__pycache__
  - MidnightSimpleUnitFrames/MidnightSimpleUnitFrames/Shell/Menu2/Assistant
  - MidnightSimpleUnitFrames/MidnightSimpleUnitFrames/Shell/Menu2/MSUF_Menu2_AssistantDialogLocale.lua
  - MidnightSimpleUnitFrames/MidnightSimpleUnitFrames/Shell/Menu2/MSUF_Menu2_AssistantDialogLocale_Data.lua
  - tools
  - README.md
  - VERSION

manual-changelog:
  filename: dist/RELEASE_NOTES_CF.html
  markup-type: html
