package-as: AddOns
enable-nolib-creation: no

move-folders:
  AddOns/MidnightSimpleUnitFrames: MidnightSimpleUnitFrames
  AddOns/MidnightSimpleUnitFrames_Castbars: MidnightSimpleUnitFrames_Castbars

ignore:
  - .github
  - .idea
  - dist
  - tools
  - README.md
  - VERSION

manual-changelog: CHANGELOG.md
