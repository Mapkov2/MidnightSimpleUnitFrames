package-as: MidnightSimpleUnitFrames
enable-nolib-creation: no

move-folders:
  MidnightSimpleUnitFrames/MidnightSimpleUnitFrames: MidnightSimpleUnitFrames
  MidnightSimpleUnitFrames/MidnightSimpleUnitFrames_Locales: MidnightSimpleUnitFrames_Locales

ignore:
  - .github
  - .idea
  - CHANGELOG.md
  - dist
  - MidnightSimpleUnitFrames/.codex-remote-attachments
  - MidnightSimpleUnitFrames/**/.codex-remote-attachments
  - MidnightSimpleUnitFrames/docs
  - MidnightSimpleUnitFrames/scripts
  - tools
  - README.md
  - VERSION

manual-changelog:
  filename: dist/RELEASE_NOTES_CF.html
  markup-type: html
