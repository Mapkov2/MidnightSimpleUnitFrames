AGENTS.md

# Local developer toolbelt: nothing below tools/ is versioned unless a rule
# below re-includes it or it is already tracked. The Classic gate, its
# manifests and the smokes it runs are tracked; a new file directly in tools/
# needs `git add -f`.
tools/
!/tools/
/tools/*
!/tools/classic-owned-addon-paths.txt
!/tools/classic-retail-overrides.tsv
!/tools/classic-addon-tombstones.txt
!/tools/MenuTest/
!/tools/search_catalog_harness.lua
# Smokes: the whole folder is versioned, so a new smoke is added without -f.
# The gate runs every smoke tools/classic-gate-smokes.tsv lists and fails on a
# tracked smoke it neither runs nor retires.
!/tools/tests/
# Local-only Retail verification scripts; the Classic gate runs only the one
# smoke below .github/scripts/tests/ that is tracked and listed in
# tools/classic-gate-smokes.tsv. The Menu2 search index generator and the
# harness it loads are tracked so a clean clone can regenerate the two index
# files (see CLASSIC_PROTOTYPE.md, "Regenerating the Menu2 search index").
.github/scripts/tests/
.github/scripts/msuf_static_checks.py
.github/scripts/blizzard_frame_ownership_smoke.lua
_local_workflows/
MidnightSimpleUnitFrames/scripts/
MidnightSimpleUnitFrames/docs/
# Hidden tool and editor folders inside the addon folders: never versioned,
# never shipped.
/MidnightSimpleUnitFrames*/**/.*/

# Local planning notes and audit write-ups. Working documents, not product docs:
# they stay on disk and are never tracked.
/*_AUDIT_*.md

# Local standalone addon worktree; not part of the MSUF repo.
/MidnightSimpleAuras/

# Python bytecode cache from the Lua test harness tooling.
__pycache__/
*.pyc
